# Public (safe in the browser bundle if you ever use the anon client client-side)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Must match the bucket you create (see supabase/migrations/002_storage_portfolio.sql)
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-media

# Server-only: never expose in client code. Used by /api/site-content and /api/admin/*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# CMS (/admin) — generate your own for production
CMS_ADMIN_PASSWORD=your-admin-password
CMS_SESSION_SECRET=your-long-random-session-secret

# Optional: canonical URL for metadata
# NEXT_PUBLIC_SITE_URL=https://bitandbytes.net

# EmailJS (contact form)
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# Optional: separate template for job applications (falls back to contact template)
# NEXT_PUBLIC_EMAILJS_APPLICATION_TEMPLATE_ID=
# Optional: applicant auto-reply / rejection emails (falls back to application template)
# NEXT_PUBLIC_EMAILJS_APPLICATION_REPLY_TEMPLATE_ID=
# Optional: dedicated rejection template (falls back to reply/application template)
# NEXT_PUBLIC_EMAILJS_REJECTION_TEMPLATE_ID=

# Cron secret for scheduled jobs (rejection emails after 7 days)
# Hit hourly: GET /api/cron/rejection-emails with Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=long-random-string

# Google reCAPTCHA v2 ("I'm not a robot" checkbox)
# Create keys at https://www.google.com/recaptcha/admin (type: v2 Checkbox)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Slack Incoming Webhook (server-only) — contact + job application alerts
# Create at https://api.slack.com/apps → Incoming Webhooks → Add to channel
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Heroku (or any host): set the same keys as Config Vars / secrets ---
# Dashboard: app → Settings → Config Vars. CLI example:
#   heroku config:set NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co" \
#     SUPABASE_SERVICE_ROLE_KEY="eyJ..." \
#     NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="portfolio-media" \
#     CMS_ADMIN_PASSWORD="..." \
#     CMS_SESSION_SECRET="long-random-string" \
#     -a bit-and-bytes
# Next.js inlines NEXT_PUBLIC_* at build time — after adding/changing those, redeploy
# (empty commit + git push heroku main, or Heroku "Deploy" again) so the new values apply.
